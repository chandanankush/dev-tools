# Version control
.git
.gitignore

# Dependencies and build output (builder stage regenerates these)
node_modules
.next
tmp

# CI artifacts left in the Jenkins workspace by previous runs — prevents old
# saved images being copied into new images (unbounded image growth)
*.tar.gz
*.tar

# Claude Code agent worktrees and memory (can be gigabytes)
.claude/

# CI helper scripts run on the Jenkins agent / deploy host, never inside the image
ci/

# Runtime data and generated files
data/
coverage

# Env files
.env
.env.local
.env.*.local

# Logs
*.log

# OS
.DS_Store

# CI config not needed inside the image
Jenkinsfile
